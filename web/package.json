{
  "name": "murmur-web",
  "private": true,
  "type": "module",
  "description": "The hub's web pages: built into static files the hub serves from its binary.",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check && svelte-check --tsconfig ./tsconfig.json",
    "demo": "ASTRO_TELEMETRY_DISABLED=1 DEMO=1 astro dev"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "svelte": "5.57.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "svelte-check": "^4.7.6",
    "typescript": "6.0.3"
  }
}
