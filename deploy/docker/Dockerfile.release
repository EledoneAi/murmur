# syntax=docker/dockerfile:1
#
# The published hub image, assembled by GoReleaser (dockers_v2 in .goreleaser.yaml) from the binaries it built.
# It carries the laptop binaries of the same release with the signed checksums, so a hub serves installs and
# updates without reaching the internet. To build from source instead, use deploy/docker/Dockerfile.

FROM gcr.io/distroless/static-debian13:nonroot@sha256:d62067879de890a1def9da0e7766b7d20810a5e5555cef8506b752437d7a3e88
ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/murmur-hub /usr/local/bin/murmur-hub
COPY dist/client/ dist/checksums.txt dist/checksums.txt.sig /usr/share/murmur/dist/
# WORKDIR creates /data owned by the image's user (nonroot), so a named volume mounted there starts out writable.
WORKDIR /data
VOLUME /data
ENV PORT=8080 \
    HOST=0.0.0.0 \
    STORE=sqlite:///data/murmur.db \
    DIST_DIR=/usr/share/murmur/dist
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/murmur-hub"]
