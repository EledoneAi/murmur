# Copy this file to .env next to docker-compose.yml, then fill it in. Keep .env private: it holds secrets.
# docs/configuration.md explains every setting; docs/self-hosting.md shows how to set up each identity provider.

# The address people and laptops use. Caddy gets the HTTPS certificate for it.
PUBLIC_URL=https://murmur.example.com

# 16 characters or more, random. For example: openssl rand -base64 32
SESSION_SECRET=

# Sign-in: keep one of the three groups below and remove the # in front of its lines.
# The redirect URL to register with the provider is PUBLIC_URL followed by /auth/callback.

# Any OpenID Connect provider: Microsoft Entra, Okta, Keycloak, Authentik, GitLab, Google...
#OIDC_ISSUER=https://login.example.com
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_NAME=Example SSO
# Microsoft Entra needs this one (docs/self-hosting.md says why):
#OIDC_TRUST_EMAIL=1

# Google
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# GitHub (set GITHUB_URL only for GitHub Enterprise Server)
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
#GITHUB_URL=https://github.example.com

# Who may join, and the first admins. The lists are read only when the hub first starts; after that, admins change
# them in the hub's admin panel. With no list, only admins can sign in.
ALLOWED_DOMAINS=example.com
#ALLOWED_EMAILS=
#ALLOWED_GITHUB_ORGS=
ADMINS=you@example.com

# Days a laptop stays signed in, 90 unless set; 0 for never. Read only when the hub first starts, like the lists.
#TOKEN_DAYS=90

# docker-compose.yml only, and optional: the instance's name in the logs and on the bus, random at each start when
# unset. compose.ha.yml ignores it, as its two instances would share it.
#INSTANCE_ID=hub-1

# docker-compose.yml only, and optional: copy the sqlite file to object storage as it changes, with the image
# MURMUR_IMAGE=ghcr.io/eledoneai/murmur-hub:<version>-litestream. deploy/litestream explains it. Amazon S3 or Azure
# Blob Storage (abs://<account>@<container>/murmur, with LITESTREAM_AZURE_ACCOUNT_KEY), not Google Cloud Storage.
#LITESTREAM_REPLICA_URL=s3://my-bucket/murmur
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#LITESTREAM_AZURE_ACCOUNT_KEY=

# compose.ha.yml only: the password of the Postgres it starts.
#POSTGRES_PASSWORD=
# compose.ha.yml only: carry events over Redis instead of Postgres (start with --profile redis).
#BUS=redis://redis:6379
