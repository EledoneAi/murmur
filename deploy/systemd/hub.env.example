# /etc/murmur/hub.env: the hub's settings, read by murmur-hub.service. It holds secrets: keep it owned by
# root with mode 600. docs/configuration.md explains every setting.

# The address people and laptops use, as your reverse proxy serves it.
PUBLIC_URL=https://murmur.example.com

# 16 characters or more, random. For example: openssl rand -base64 32
SESSION_SECRET=

# The hub listens on this port on every interface. Let only the reverse proxy reach it.
PORT=8080

# The reverse proxy appends each client's address to X-Forwarded-For (Caddy and the nginx setup in
# docs/self-hosting.md do). Remove this line if nothing sits in front of the hub.
TRUST_PROXY=1

# The data, in the service's state folder.
STORE=sqlite:///var/lib/murmur/murmur.db

# The laptop binaries this hub serves, from the same release as the hub (see README.md).
DIST_DIR=/usr/share/murmur/dist

# Sign-in: keep one of the three groups below and remove the # in front of its lines.
# The redirect URL to register with the provider is PUBLIC_URL followed by /auth/callback.
#OIDC_ISSUER=https://login.example.com
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_NAME=Example SSO
# Microsoft Entra needs this one (docs/self-hosting.md says why):
#OIDC_TRUST_EMAIL=1
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
#GITHUB_URL=https://github.example.com

# Who may join, and the first admins. The lists are read only when the hub first starts; after that, admins change
# them in the hub's admin panel. With no list, only admins can sign in.
ALLOWED_DOMAINS=example.com
#ALLOWED_EMAILS=
#ALLOWED_GITHUB_ORGS=
ADMINS=you@example.com

# Days a laptop stays signed in, 90 unless set; 0 for never. Read only when the hub first starts, like the lists.
#TOKEN_DAYS=90

# Optional: this instance's name in the logs and on the bus. Random at each start when unset.
#INSTANCE_ID=hub-1
